# MUDHOTECH HR RECRUITING SYSTEM - Nginx site (docs/10 §5, docs/06 §1). Rendered at container start by the
# official image (envsubst of ${MHRS_DOMAIN} and ${MHRS_ENVIRONMENT} only; nginx variables are untouched).
#   staging:    MHRS_DOMAIN=staging.hr.example.co.zw MHRS_ENVIRONMENT=staging
#   production: MHRS_DOMAIN=hr.example.co.zw         MHRS_ENVIRONMENT=production
# Host-specific files live in /etc/mhrs/nginx on the server (mounted at /etc/nginx/local):
#   ops-allowlist.conf (allow <ip>; ... deny all;)  and  flower.htpasswd

# ---- http context -------------------------------------------------------------------------------
server_tokens off;
charset utf-8;

log_format mhrs_json escape=json
  '{"time":"$time_iso8601","remote_addr":"$remote_addr","request_id":"$request_id",'
  '"method":"$request_method","uri":"$uri","status":$status,"bytes":$body_bytes_sent,'
  '"request_time":$request_time,"upstream_time":"$upstream_response_time",'
  '"upstream":"$upstream_addr","host":"$host","user_agent":"$http_user_agent"}';
# $uri (not $request_uri): query strings may carry tokens and personal data, so they are not logged
access_log /var/log/nginx/access.log mhrs_json;

# rate limits (docs/10 §5). Only state-changing auth calls are limited: an empty key is not counted,
# so the SPA's session checks (GET) are never throttled.
map $request_method $mhrs_auth_key {
  POST    $binary_remote_addr;
  default "";
}
limit_req_zone $mhrs_auth_key      zone=auth:10m   rate=10r/m;
limit_req_zone $binary_remote_addr zone=search:10m rate=60r/m;
limit_req_status 429;
limit_conn_zone $binary_remote_addr zone=perip:10m;

# websocket upgrades pass through; otherwise no Connection header, so upstream keepalive works
map $http_upgrade $connection_upgrade {
  default upgrade;
  ""      "";
}

gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types text/plain text/css text/xml application/json application/javascript application/xml
           application/rss+xml image/svg+xml application/manifest+json;

# Upstream servers come from /etc/nginx/local/upstreams/{backend,frontend}.conf, normally the compose service
# name (`server backend:8000 resolve;`). During a rolling deploy deploy.sh points them at the new container,
# reloads nginx gracefully, stops the old container, then points them back at the service name - so nginx
# never sends a request to a container that is going away. Names are re-resolved through Docker's DNS
# (`resolve`, open-source nginx >= 1.27.3), which also covers container restarts.
resolver 127.0.0.11 valid=5s ipv6=off;
resolver_timeout 2s;

# Idle upstream connections are closed by nginx (4 s) before the app servers close them (gunicorn
# --keep-alive 5, Node's default 5 s), so nginx never reuses a connection the server is dropping.
upstream mhrs_frontend {
  zone mhrs_frontend 64k;
  include /etc/nginx/local/upstreams/frontend.conf;
  keepalive 32;
  keepalive_timeout 4s;
}
upstream mhrs_backend {
  zone mhrs_backend 64k;
  include /etc/nginx/local/upstreams/backend.conf;
  keepalive 32;
  keepalive_timeout 4s;
}

# ---- port 80: ACME challenges + redirect to HTTPS ------------------------------------------------
server {
  listen 80 default_server;
  listen [::]:80 default_server;
  server_name ${MHRS_DOMAIN};

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    default_type text/plain;
  }
  # load balancer / uptime probes over plain HTTP
  location = /healthz {
    access_log off;
    proxy_pass http://mhrs_backend;
    include /etc/nginx/snippets/proxy.conf;
  }
  location / {
    return 301 https://$host$request_uri;
  }
}

# unknown Host headers (scanners hitting the IP): close the connection
server {
  listen 443 ssl default_server;
  listen [::]:443 ssl default_server;
  http2 on;
  server_name _;
  include /etc/nginx/snippets/tls.conf;
  return 444;
}

# ---- port 443: the application -------------------------------------------------------------------
server {
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;
  server_name ${MHRS_DOMAIN};

  include /etc/nginx/snippets/tls.conf;
  include /etc/nginx/snippets/security-headers.conf;
  include /etc/nginx/snippets/env-${MHRS_ENVIRONMENT}.conf;

  client_max_body_size 30m;
  client_body_timeout 30s;
  limit_conn perip 50;

  # never serve dotfiles (.env, .git ...); ACME is only on port 80
  location ~ /\.(?!well-known/) {
    deny all;
    return 404;
  }

  location = /healthz {
    access_log off;
    proxy_pass http://mhrs_backend;
    include /etc/nginx/snippets/proxy.conf;
  }
  location = /readyz {
    include /etc/nginx/local/ops-allowlist.conf;
    proxy_pass http://mhrs_backend;
    include /etc/nginx/snippets/proxy.conf;
  }

  # Django static files (admin, API docs), collected into the shared `static` volume
  location ^~ /static/ {
    alias /srv/static/;
    access_log off;
    expires 7d;
    add_header Cache-Control "public, max-age=604800" always;
    include /etc/nginx/snippets/security-headers.conf;
  }

  # auth: sign-in, sign-up, password reset, MFA (POST limited to 10/min per IP, small bursts)
  location ^~ /api/v1/auth/ {
    limit_req zone=auth burst=5 nodelay;
    proxy_pass http://mhrs_backend;
    include /etc/nginx/snippets/proxy.conf;
  }
  # public job search (API and the server-rendered board)
  location ^~ /api/v1/jobs/ {
    limit_req zone=search burst=30 nodelay;
    proxy_pass http://mhrs_backend;
    include /etc/nginx/snippets/proxy.conf;
  }
  location = /jobs {
    limit_req zone=search burst=30 nodelay;
    proxy_pass http://mhrs_frontend;
    include /etc/nginx/snippets/proxy.conf;
  }

  # internal tools: operator IP allow-list only
  location ^~ /django-admin/ {
    include /etc/nginx/local/ops-allowlist.conf;
    proxy_pass http://mhrs_backend;
    include /etc/nginx/snippets/proxy.conf;
  }
  # prefix (not regex) locations: `^~ /api/` below would otherwise win and skip the allow-list
  location ^~ /api/docs/ {
    include /etc/nginx/local/ops-allowlist.conf;
    proxy_pass http://mhrs_backend;
    include /etc/nginx/snippets/proxy.conf;
  }
  location ^~ /api/schema/ {
    include /etc/nginx/local/ops-allowlist.conf;
    proxy_pass http://mhrs_backend;
    include /etc/nginx/snippets/proxy.conf;
  }
  location ^~ /flower/ {
    include /etc/nginx/local/ops-allowlist.conf;
    auth_basic "MHRS operations";
    auth_basic_user_file /etc/nginx/local/flower.htpasswd;
    # flower runs on the `ops` profile; resolve lazily so nginx starts without it
    resolver 127.0.0.11 valid=30s ipv6=off;
    set $mhrs_flower http://flower:5555;
    proxy_pass $mhrs_flower;
    include /etc/nginx/snippets/proxy.conf;
  }

  location ^~ /api/ {
    proxy_pass http://mhrs_backend;
    include /etc/nginx/snippets/proxy.conf;
  }

  # Next.js build assets are content-hashed: cache for a year
  location ^~ /_next/static/ {
    proxy_pass http://mhrs_frontend;
    include /etc/nginx/snippets/proxy.conf;
    expires 365d;
    access_log off;
  }

  location / {
    proxy_pass http://mhrs_frontend;
    include /etc/nginx/snippets/proxy.conf;
  }
}
