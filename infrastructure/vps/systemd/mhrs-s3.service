# MHRS private S3 storage (SeaweedFS, ADR-021) on loopback only. Browsers reach signed links through
# nginx on the site's own host name. Data lives in /srv/mhrs/s3-data (backed up by mhrs-backup).
[Unit]
Description=MHRS - S3 storage (SeaweedFS, 127.0.0.1:8533)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mhrs
Group=mhrs
WorkingDirectory=/srv/mhrs/s3-data
ExecStart=/srv/mhrs/tools/weed server -dir=/srv/mhrs/s3-data \
    -ip=127.0.0.1 -ip.bind=127.0.0.1 \
    -master.port=9533 -volume.port=8580 -filer.port=8588 -volume.max=0 \
    -s3 -s3.port=8533 -s3.config=/srv/mhrs/run/s3.json
Restart=always
RestartSec=5
MemoryMax=500M

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/mhrs/s3-data

[Install]
WantedBy=multi-user.target
