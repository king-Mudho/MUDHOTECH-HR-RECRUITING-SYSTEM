# MHRS backend environment on the shared VPS. Written by setup-server.sh with generated
# secrets (never printed). Readable only by the mhrs user. Edit on the server, then:
#   sudo systemctl restart mhrs-backend mhrs-worker mhrs-beat
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=__SECRET_KEY__
DEBUG=False
ALLOWED_HOSTS=__SITE_DOMAIN__
CSRF_TRUSTED_ORIGINS=https://__SITE_DOMAIN__
FRONTEND_URL=https://__SITE_DOMAIN__
LOG_LEVEL=INFO
TENANT_STRICT_MODE=False

DATABASE_URL=postgres://__DB_USER__:__DB_PASSWORD__@127.0.0.1:5432/__DB_NAME__
DB_POOL_MAX=6

REDIS_URL=redis://127.0.0.1:6379/__REDIS_QUEUE_DB__
CACHE_URL=redis://127.0.0.1:6379/__REDIS_CACHE_DB__
CELERY_BROKER_URL=redis://127.0.0.1:6379/__REDIS_QUEUE_DB__
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/__REDIS_QUEUE_DB__

# Private SeaweedFS S3 on loopback; browsers reach signed links through nginx on the same host.
S3_ENDPOINT_URL=http://127.0.0.1:__S3_PORT__
S3_PUBLIC_ENDPOINT_URL=https://__SITE_DOMAIN__
S3_ACCESS_KEY=__S3_ACCESS_KEY__
S3_SECRET_KEY=__S3_SECRET_KEY__
S3_REGION=us-east-1
S3_BUCKET_QUARANTINE=mhrs-uploads-quarantine
S3_BUCKET_DOCUMENTS=mhrs-documents
S3_BUCKET_EXPORTS=mhrs-exports
S3_BUCKET_PUBLIC=mhrs-public

# Email: printed to the worker log until a real mailbox is configured with configure-email.sh.
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL="MUDHOTECH HR RECRUITING SYSTEM <no-reply@__SITE_DOMAIN__>"
SUPPORT_EMAIL=support@__SITE_DOMAIN__

FIELD_ENCRYPTION_KEYS=k1:__FERNET_KEY__

DOCUMENT_SCANNER=clamd
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=__CLAMD_PORT__

LLM_PROVIDER=none
# Semantic skill matching needs a CPU with AVX2 (PyTorch). setup-server.sh sets false when the
# server's CPU lacks it; matching then uses the skills taxonomy and rules only.
SEMANTIC_SKILL_MATCHING=__SEMANTIC__
EMBEDDING_MODEL=__EMBEDDING_MODEL__
HF_HOME=__HF_HOME__

# Integrations stay simulated and billing is not enforced until the owner switches them on.
INTEGRATIONS_SANDBOX=true
BILLING_ENFORCE=false
CALLBACK_BASE_URL=https://__SITE_DOMAIN__
PAYNOW_RESULT_URL_BASE=https://__SITE_DOMAIN__
ENABLE_DJANGO_ADMIN=False
