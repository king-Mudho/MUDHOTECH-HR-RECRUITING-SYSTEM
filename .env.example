# =====================================================================================
# MUDHOTECH HR RECRUITING SYSTEM - environment configuration (docs/10 §2)
# Copy to .env (scripts/dev-up.* does this). NEVER commit .env or real secrets.
# Values below are for LOCAL DEVELOPMENT ONLY.
# =====================================================================================

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=dev-only-change-me-0123456789abcdefghijklmnopqrstuvwxyz
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=INFO
TENANT_STRICT_MODE=true

# --- Database / Redis (service names resolve inside docker compose) ---
DATABASE_URL=postgres://mhrs:mhrs@postgres:5432/mhrs
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/3

# --- Object storage (dev: SeaweedFS S3 gateway; prod: AWS S3 via instance role) ---
S3_ENDPOINT_URL=http://s3:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=mhrs-s3-dev
S3_SECRET_KEY=mhrs-s3-dev-secret
S3_REGION=af-south-1
S3_BUCKET_QUARANTINE=mhrs-uploads-quarantine
S3_BUCKET_DOCUMENTS=mhrs-documents
S3_BUCKET_EXPORTS=mhrs-exports
S3_BUCKET_PUBLIC=mhrs-public

# --- Email (dev: Mailpit; prod: SES SMTP or smtp+tls://user:pass@email-smtp.af-south-1.amazonaws.com:587) ---
EMAIL_URL=smtp://mailpit:1025
DEFAULT_FROM_EMAIL=MUDHOTECH HR RECRUITING SYSTEM <no-reply@mhrs.local>
AWS_SES_REGION=af-south-1
AWS_SES_CONFIGURATION_SET=

# --- Platform admin bootstrap (python manage.py create_platform_admin) ---
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# --- Field encryption (ADR-011). Generate: python -c "from cryptography.fernet import Fernet; print('k1:'+Fernet.generate_key().decode())"
# First key encrypts; all keys decrypt. Rotate by prepending a new key id.
FIELD_ENCRYPTION_KEYS=k1:ZGV2LW9ubHkta2V5LWRvLW5vdC11c2UtaW4tcHJvZDE=

# --- ClamAV ---
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# --- Monitoring ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- AI (LLM disabled by default - D-06) ---
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Billing (Phase 14) ---
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=

# --- Frontend ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
API_INTERNAL_URL=http://backend:8000

# --- Host port overrides (change if a port is already in use on your machine) ---
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=6380
S3_HOST_PORT=9000
S3_FILER_HOST_PORT=8888
MAILPIT_UI_HOST_PORT=8025
MAILPIT_SMTP_HOST_PORT=1025
CLAMAV_HOST_PORT=3310
BACKEND_HOST_PORT=8000
FLOWER_HOST_PORT=5555
FRONTEND_HOST_PORT=3000
