# syntax=docker/dockerfile:1.7
# MHRS Celery workers: adds OCR (Tesseract), poppler, libmagic and the local embedding model.
# Multi-stage: `builder` resolves the environment (incl. the ml extra) and downloads the model once;
# `runtime` carries the virtualenv, the model cache and the source, and runs as `app`.
ARG PYTHON_IMAGE=python:3.12.16-slim-trixie

FROM ghcr.io/astral-sh/uv:0.13.9 AS uv

FROM ${PYTHON_IMAGE} AS builder
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_COMPILE_BYTECODE=1 \
    UV_COMPILE_BYTECODE_TIMEOUT=600 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    HF_HOME=/opt/hf-cache
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
ARG UV_SYNC_ARGS="--frozen --no-install-project"
# the ml extra (embeddings) is always part of the worker image, whatever UV_SYNC_ARGS says
RUN --mount=type=cache,target=/root/.cache/uv uv sync ${UV_SYNC_ARGS} --extra ml
# Local embedding model (ADR-010) baked into the image; workers never call out at runtime.
ARG EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RUN /opt/venv/bin/python -c "from sentence_transformers import SentenceTransformer as S; S('${EMBEDDING_MODEL}', device='cpu')" \
 && chmod -R a+rX /opt/hf-cache

FROM ${PYTHON_IMAGE} AS runtime
ARG MHRS_VERSION=dev
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH" \
    HF_HOME=/opt/hf-cache \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    MHRS_VERSION=${MHRS_VERSION}
LABEL org.opencontainers.image.title="mhrs-worker" \
      org.opencontainers.image.vendor="MudhoTech Solutions (Pvt) Ltd" \
      org.opencontainers.image.version="${MHRS_VERSION}"

RUN apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && apt-get install -y --no-install-recommends \
      curl libpq5 tesseract-ocr tesseract-ocr-eng poppler-utils libmagic1 \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 10001 app \
 && useradd --system --uid 10001 --gid app --create-home --home-dir /home/app app

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /opt/hf-cache /opt/hf-cache
WORKDIR /app
COPY --chown=app:app . .

USER 10001
# liveness: the worker answers a broker ping addressed to itself (docker-compose.prod.yml sets it)
CMD ["celery", "-A", "config", "worker", "-Q", "default", "-l", "info", "--max-tasks-per-child", "200"]
