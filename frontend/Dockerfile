# syntax=docker/dockerfile:1.7
# MHRS frontend (Next.js). Stages: deps -> dev (docker compose) | build -> runtime (prod).
# The base is pinned to an exact version (bump deliberately; Dependabot proposes updates).
ARG NODE_IMAGE=node:24.22.3-alpine3.24
FROM ${NODE_IMAGE} AS deps
WORKDIR /app
RUN apk add --no-cache libc6-compat
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci

FROM deps AS dev
# Dev-compose only (bind mounts + named node_modules volume); the runtime stage runs as `app`.
ENV NEXT_TELEMETRY_DISABLED=1
COPY . .
EXPOSE 3000
# nosemgrep: dockerfile.security.missing-user.missing-user
CMD ["sh", "-c", "npm ci --prefer-offline --no-audit --no-fund >/dev/null && npm run dev -- --hostname 0.0.0.0 --port 3000"]

FROM deps AS build
ENV NEXT_TELEMETRY_DISABLED=1
COPY . .
# public/ may be empty in git (robots.txt is generated by app/robots.ts); make sure it exists.
RUN mkdir -p public && npm run build

FROM ${NODE_IMAGE} AS runtime
ARG MHRS_VERSION=dev
LABEL org.opencontainers.image.title="mhrs-frontend" \
      org.opencontainers.image.vendor="MudhoTech Solutions (Pvt) Ltd" \
      org.opencontainers.image.version="${MHRS_VERSION}"
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0 MHRS_VERSION=${MHRS_VERSION}
RUN addgroup -S -g 10001 app && adduser -S -u 10001 -G app app
COPY --from=build --chown=app:app /app/.next/standalone ./
COPY --from=build --chown=app:app /app/.next/static ./.next/static
COPY --from=build --chown=app:app /app/public ./public
USER 10001
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 CMD wget -qO- http://127.0.0.1:3000/ >/dev/null || exit 1
CMD ["node", "server.js"]
